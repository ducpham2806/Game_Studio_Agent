{"nodes": [{"id": "$graphify-root$_skills_09_web_and_other_engines_threejs_materials_lighting_skill_md", "label": "SKILL.md", "file_type": "document", "node_kind": "page", "source_file": "skills/09-web-and-other-engines/threejs-materials-lighting/SKILL.md", "source_location": "L1", "frontmatter": {"name": "threejs-materials-lighting", "description": "Light and shade a three.js scene: choose materials (MeshStandardMaterial PBR vs unlit MeshBasicMaterial), add ambient/hemisphere/directional/point/spot lights, turn on shadow maps, and use an environment map (IBL) for realistic reflections. Use when a three.js model looks black, flat, or wrong \u2014 when the user mentions three.js materials, MeshStandardMaterial, lights, shadows, envMap, or PBR. For renderer/loop setup use threejs-scene-setup; for loading models use threejs-gltf-loading."}}, {"id": "$graphify-root$_skills_09_web_and_other_engines_threejs_materials_lighting_skill_three_js_materials_lighting", "label": "three.js Materials & Lighting", "file_type": "document", "node_kind": "heading", "source_file": "skills/09-web-and-other-engines/threejs-materials-lighting/SKILL.md", "source_location": "L13"}, {"id": "$graphify-root$_skills_09_web_and_other_engines_threejs_materials_lighting_skill_when_to_use", "label": "When to use", "file_type": "document", "node_kind": "heading", "source_file": "skills/09-web-and-other-engines/threejs-materials-lighting/SKILL.md", "source_location": "L19"}, {"id": "$graphify-root$_skills_09_web_and_other_engines_threejs_materials_lighting_skill_core_workflow", "label": "Core workflow", "file_type": "document", "node_kind": "heading", "source_file": "skills/09-web-and-other-engines/threejs-materials-lighting/SKILL.md", "source_location": "L31"}, {"id": "$graphify-root$_skills_09_web_and_other_engines_threejs_materials_lighting_skill_patterns", "label": "Patterns", "file_type": "document", "node_kind": "heading", "source_file": "skills/09-web-and-other-engines/threejs-materials-lighting